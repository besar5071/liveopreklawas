# Salin ke .streamlit/secrets.toml (lokal) atau isi di Streamlit Cloud → Settings → Secrets.
# File secrets.toml asli tidak boleh di-commit.

[relay]
# API key relay.fast (https://relay.fast/). Dipakai tab "✍️ Video dari Teks" untuk draf skenario.
api_key = "sk-ISI_API_KEY_RELAY_FAST"
model = "gpt-6-astra"
